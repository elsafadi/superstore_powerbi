// =============================================================================
// DAX MEASURES — Superstore Sales Analytics
// =============================================================================


// Measures are grouped by purpose:
//   1. Core KPIs            - the basics every dashboard needs
//   2. Time Intelligence     - YoY growth, running totals (needs a marked Date table)
//   3. Profitability         - margin analysis, discount impact
//   4. Customer Analytics    - RFM-based segment measures
// =============================================================================


// -----------------------------------------------------------------------
// 1. CORE KPIs
// -----------------------------------------------------------------------

Total Sales =
SUM ( FactSales[sales] )
// Simple aggregation, but always define it as a measure (never use the raw
// column directly in a visual) so every other measure can reference it and
// stays consistent if the underlying calculation ever changes.

Total Profit =
SUM ( FactSales[profit] )

Total Orders =
DISTINCTCOUNT ( FactSales[order_id] )
// Distinct count matters here: one order can have multiple line items
// (multiple products), so COUNTROWS would overstate the number of orders.

Total Units Sold =
SUM ( FactSales[order_quantity] )

Average Order Value =
DIVIDE ( [Total Sales], [Total Orders] )
// Always use DIVIDE() instead of the "/" operator in DAX — it safely
// returns BLANK() instead of throwing a divide-by-zero error when a
// filter context has no orders.

Overall Profit Margin % =
DIVIDE ( [Total Profit], [Total Sales] )


// -----------------------------------------------------------------------
// 2. TIME INTELLIGENCE
// -----------------------------------------------------------------------
// These all require DimDate to be marked as a Date Table in Power BI
// (Modeling > Mark as Date Table) with a continuous, gap-free date range.

Sales YTD =
TOTALYTD ( [Total Sales], DimDate[date] )

Sales Prior Year =
CALCULATE ( [Total Sales], SAMEPERIODLASTYEAR ( DimDate[date] ) )

Sales YoY Growth % =
DIVIDE ( [Total Sales] - [Sales Prior Year], [Sales Prior Year] )

Sales Running Total =
CALCULATE (
    [Total Sales],
    FILTER (
        ALLSELECTED ( DimDate[date] ),
        DimDate[date] <= MAX ( DimDate[date] )
    )
)
// A running/cumulative total over whatever date range is currently
// filtered/selected in the report (e.g. a slicer). Useful for a
// cumulative-sales line chart that keeps climbing across the year.

Sales - Same Month Last Year =
CALCULATE (
    [Total Sales],
    DATEADD ( DimDate[date], -1, YEAR )
)


// -----------------------------------------------------------------------
// 3. PROFITABILITY
// -----------------------------------------------------------------------

Average Discount % =
AVERAGE ( FactSales[discount] )

High Discount Sales =
CALCULATE ( [Total Sales], FactSales[discount] >= 0.2 )
// Sales made at 20%+ discount — useful for a card/KPI that flags how much
// revenue is coming from heavily discounted orders, a common exec question.

Profit per Order =
DIVIDE ( [Total Profit], [Total Orders] )

Loss-Making Orders =
CALCULATE (
    DISTINCTCOUNT ( FactSales[order_id] ),
    FactSales[profit] < 0
)
// Count of orders that lost money — a strong talking point in your README
// ("X% of orders are unprofitable, driven mainly by the Tables sub-category
// and Delivery Truck shipping").


// -----------------------------------------------------------------------
// 4. CUSTOMER ANALYTICS (RFM)
// -----------------------------------------------------------------------
// These reference DimCustomerRFM, joined to DimCustomer on customer_key.

Customer Count =
DISTINCTCOUNT ( DimCustomer[customer_key] )

Champions Count =
CALCULATE (
    DISTINCTCOUNT ( DimCustomerRFM[customer_key] ),
    DimCustomerRFM[segment] = "Champions"
)

At-Risk High-Value Customers =
CALCULATE (
    DISTINCTCOUNT ( DimCustomerRFM[customer_key] ),
    DimCustomerRFM[segment] = "At Risk (High Value)"
)
// This is the single most "actionable" number in the whole dashboard:
// customers who used to spend a lot and haven't ordered recently. Frame
// this in your README as "X customers worth retention outreach."

At-Risk Historical Value =
CALCULATE (
    SUM ( DimCustomerRFM[monetary] ),
    DimCustomerRFM[segment] = "At Risk (High Value)"
)
// The $ sum of all-time sales from those at-risk customers -- pairs with
// the card above. This is proven historical spend that's gone quiet, not
// a projected loss, so phrase it that way on the card ("revenue at risk
// of churn," not "revenue we are losing").

Average Customer Lifetime Sales =
AVERAGE ( DimCustomerRFM[monetary] )


// -----------------------------------------------------------------------
// 5. UNIFIED COLOR SYNCHRONIZATION (UI & MARKERS)
// -----------------------------------------------------------------------
// This measure in Conditional Formatting (fx) > Field Value for both 
// the Donut Chart slices on Page 3 and the Scatter Chart markers.

RFM Segment Color = 
SWITCH (
    SELECTEDVALUE ( DimCustomerRFM[segment] ),
    "Champions", "#2A9D8F",            -- Deep Teal Green (High Value)
    "Loyal Customers", "#118DFF",      -- Bright Blue (Stable Core)
    "New / Promising", "#E9C46A",      -- Warm Yellow (Nurture/Growth)
    "Needs Attention", "#E66C37",      -- Orange (Mid-Level Risk)
    "At Risk (High Value)", "#D64550", -- Red-Coral (Urgent Retention Risk)
    "Lost / Churned", "#7F7F7F",        -- Neutral Gray (Inactive/Churned)
    "#A6A6A6"                          -- Fallback Gray for blanks
)
