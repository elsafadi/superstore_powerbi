__pycache__/
*.pyc
.DS_Store
*.pbix.bak

# Power BI Desktop lock file — created automatically while a .pbix is open,
# deleted when closed. Never wanted in version control.
~$*.pbix

# Power BI temp/cache folders some setups generate
*.pbix.tmp
.pbi/
*.user.config
*.cache

# Power BI Project (PBIP) local-only files — auto-generated by Power BI
# Desktop itself when you save as .pbip. localSettings.json holds
# machine-specific report settings; cache.abf is a local data cache.
# Neither should ever be committed, even though .pbi/ above already
# covers the folder broadly — kept explicit here since Power BI writes
# these itself and expects them ignored.
**/.pbi/localSettings.json
**/.pbi/cache.abf

# Python virtual environments, in case you set one up locally
.venv/
venv/
env/

# Jupyter, if you ever explore the data in a notebook
.ipynb_checkpoints/

# Editor/IDE folders
.vscode/
.idea/

# OS clutter (Windows)
Thumbs.db
desktop.ini
